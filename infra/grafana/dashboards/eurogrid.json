{
  "uid": "eurogrid-pipeline",
  "title": "EuroGrid Pipeline",
  "tags": ["eurogrid", "medallion"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dataset diblokir quality gate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(eurogrid_silver_gate_blocked)",
          "legendFormat": "diblokir"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Umur sukses terakhir",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 86400},
              {"color": "red", "value": 172800}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(eurogrid_flow_last_success_timestamp_seconds)",
          "legendFormat": "sejak sukses"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error scrape terakhir",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(eurogrid_exporter_scrape_errors_total[10m])) or vector(0)",
          "legendFormat": "error"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Baris per tabel",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "eurogrid_table_rows{table!~\".*_quality_report|.*_quarantine\"}",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Karantina dan baris gagal terakhir",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "eurogrid_quarantine_rows",
          "legendFormat": "karantina {{dataset}}"
        },
        {
          "refId": "B",
          "expr": "eurogrid_silver_rows_failed",
          "legendFormat": "gagal {{dataset}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kesegaran tabel (detik sejak snapshot terakhir)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 0, "lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "eurogrid_table_freshness_seconds{layer=\"bronze\"}",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Status run terakhir per flow",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "spanNulls": true}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "eurogrid_flow_last_run_state",
          "legendFormat": "{{flow}} {{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Durasi run terakhir",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 25},
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "bars", "fillOpacity": 20, "lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "eurogrid_flow_last_duration_seconds",
          "legendFormat": "{{flow}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU node (%)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 25},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memori tersedia",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 25},
      "fieldConfig": {
        "defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "tersedia"
        }
      ]
    }
  ]
}
